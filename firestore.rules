rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The PWA and the local bridge authenticate with Firebase before interacting
    // with the queue. Jobs are scoped to this restaurant instance.
    match /print_jobs/{jobId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.restaurantId == 'kolhapuri-khanawal';
      allow delete: if signedIn();
    }

    match /print_bridges/{bridgeId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.restaurantId == 'kolhapuri-khanawal';
    }
  }
}
